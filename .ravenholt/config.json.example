{
    "system": {
        "listen_addr": "0.0.0.0",
        "listen_port": 8000,
        "encrypt_key": "replace-with-at-least-32-random-characters",
        "bootstrap_admin": {
            "enabled": true,
            "username": "admin",
            "email": "admin@ravenholt.local",
            "password": "replace-with-a-strong-password"
        }
    },
    "database": {
        "host": "127.0.0.1",
        "port": 5432,
        "database": "ravenholt",
        "username": "root",
        "password": "123456",
        "pool_size": 32,
        "max_overflow": 32,
        "pool_timeout_seconds": 30,
        "pool_recycle_seconds": 1800,
        "pool_pre_ping": true
    },
    "agent_runtime": {
        "main_max_turns": 1000,
        "subordinate_max_turns": 1000,
        "model_stream_idle_timeout_seconds": 600,
        "context_compression_enabled": true,
        "context_compression_trigger_ratio": 0.95,
        "context_compression_hard_stop_ratio": 0.98,
        "context_compression_target_ratio": 0.20,
        "context_compression_preserve_recent_ratio": 0.25,
        "context_compression_preserve_recent_items": 20,
        "context_compression_min_items": 12,
        "context_compression_summary_max_tokens": 8000
    },
    "agent_pool": {
        "max_size": 256,
        "ttl_seconds": 1800,
        "sweep_interval_seconds": 60
    },
    "agents": {
        "cso": {
            "code": "cso",
            "name": "默认预设",
            "description": "主线 root 使用的模型配置",
            "base_url": "https://api.deepseek.com/v1",
            "api_key": "",
            "model": "deepseek-v4-flash",
            "use_responses": false,
            "context_window": 1000000
        }
    },
    "sandbox": {
        "network": "ravenholt-lan",
        "image": ""
    },
    "integrations": {
        "web_search_provider": "auto",
        "exa_api_key": "",
        "perplexity_api_key": "",
        "deepseek_api_key": "",
        "deepseek_base_url": "https://api.deepseek.com",
        "searxng_base_url": "http://127.0.0.1:8888",
        "searxng_bind_addr": "0.0.0.0",
        "searxng_general_engines": false
    }
}
